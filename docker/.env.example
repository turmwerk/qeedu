# ------------------------------------------------------------------
# QeEdu Community Edition Docker Compose defaults.
# Copy this file to .env before starting:
#   cp .env.example .env
#   docker compose up -d --build
#
# Keep secrets only in docker/.env. Do not commit docker/.env.
# ------------------------------------------------------------------

# Public access
EXPOSE_WEB_PORT=3000
EXPOSE_API_PORT=8080
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
GIN_MODE=release

# Release image deployment. Used by docker-compose.release.yaml.
QEEDU_IMAGE_PREFIX=ghcr.io/turmwerk
QEEDU_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=qeedu-change-me
MYSQL_DATABASE=qeedu
DATABASE_DSN=root:qeedu-change-me@tcp(mysql:3306)/qeedu?charset=utf8mb4&parseTime=True&loc=Local

# Auth and security
JWT_SECRET=change-this-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8080/api/v1/auth/microsoft/callback

# Email code delivery. If unset, development responses include dev_code.
RESEND_EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# LLM provider. OpenAI-compatible gateways such as OpenRouter are supported.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=liquid/lfm-2.5-1.2b-instruct:free
LLM_FIX_MODEL=liquid/lfm-2.5-1.2b-instruct:free
LLM_COPILOT_MODEL=liquid/lfm-2.5-1.2b-instruct:free
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Local CLI fallback for ai-chat. Keep disabled for portable CE deployments.
LLM_FALLBACK_PROVIDER=auto
CODEX_BIN=codex
CODEX_HOME=
CODEX_WORKDIR=/tmp
CODEX_SANDBOX=read-only
CODEX_REASONING_EFFORT=low
CODEX_REASONING_SUMMARY=none
CODEX_VERBOSITY=low
LLM_CLI_TIMEOUT_SECONDS=240

# Internal service addresses. Defaults match docker-compose.yaml.
USER_SERVICE_ADDR=user-services:50051
SANDBOX_SERVICE_ADDR=sandbox:50052
AI_COPILOT_SERVICE_ADDR=ai-copilot:50053
AI_CHAT_SERVICE_ADDR=ai-chat:50054
